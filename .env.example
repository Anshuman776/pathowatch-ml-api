# ---- model artifact (choose ONE) ----
MODEL_PATH=artifacts/model.joblib
# MODEL_URL=https://github.com/<you>/pathowatch-models/releases/download/v20261029/model.joblib
# MODEL_SHA256=<value from model_card.json>   # recommended with MODEL_URL

# ---- security ----
# comma-separated keys the website may use (send as header X-API-Key)
ML_API_KEYS=change-me-long-random-string
# separate key for POST /v1/admin/reload (header X-Admin-Key)
ML_ADMIN_KEY=change-me-another-long-random-string
# only needed if a BROWSER calls this service directly (the website calls it from its server, so usually empty)
ALLOWED_ORIGINS=

# ---- behaviour ----
REFERENCE_COUNTRY=India
MIN_LOCAL_ISOLATES=20
LOG_LEVEL=INFO
